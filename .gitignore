# 本地数据与个人素材：绝不入库
# ---------------------------------------------------------------
# 本机自用数据（含真人照片、名人画像、生成产物、会话记录）全部不纳入版本管理。
# 公开仓库只保留 data/*.example.json 模板。
# 注意：必须先排除 /data/* 而不是整个 /data/ 目录，否则 Git 不会进目录，下面的 ! 规则失效。
/data/*
!/data/*.example.json

# 本地生成产物 / 中间文件 / 日志
/output/
/temp/
/logs/
*.log
*.bak
*.bak_*
__pycache__/
*.pyc
/temp_boot*

# 模型权重与缓存（体积大，且可能涉及来源不明的授权）
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx

# 本地配置（可能含绝对路径与内部目录名）
/config.local.json

# 编辑器与系统
.vscode/
.idea/
Thumbs.db
desktop.ini
# 本机真实配置（含本机盘符路径）不入库，样例见 config.example.json
config.json

# install.py / bootstrap.py 生成的启动脚本内嵌本机 Python / ComfyUI 绝对路径，同样不入库
/start.bat
/start.sh
/一键启动.bat
/一键启动.sh

# 开发过程截图与临时产物（根目录一次性调试文件，不入库）
/*.png
/*.err
temp_*.log
*.err.log

# 内部开发过程记录（含本机盘符与客户素材目录结构，不入公开库）
/docs/*_2026*.md
