{
  "1": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{ref_image}}" }
  },
  "2": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "{{video}}",
      "force_rate": "{{fps}}",
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": "{{length}}",
      "skip_first_frames": 0,
      "select_every_nth": 1
    }
  },
  "3": {
    "class_type": "OnnxDetectionModelLoader",
    "inputs": {
      "vitpose_model": "{{vitpose}}",
      "yolo_model": "{{yolo}}",
      "onnx_device": "CUDAExecutionProvider"
    }
  },
  "4": {
    "class_type": "PoseAndFaceDetection",
    "inputs": {
      "model": ["3", 0],
      "images": ["2", 0],
      "width": "{{width}}",
      "height": "{{height}}",
      "face_padding": 0
    }
  },
  "5": {
    "class_type": "DrawViTPose",
    "inputs": {
      "pose_data": ["4", 0],
      "width": "{{width}}",
      "height": "{{height}}",
      "retarget_padding": 16,
      "body_stick_width": -1,
      "hand_stick_width": -1,
      "draw_head": true
    }
  },
  "6": {
    "class_type": "WanVideoModelLoader",
    "inputs": {
      "model": "{{unet}}",
      "base_precision": "bf16",
      "quantization": "disabled",
      "load_device": "offload_device"
    }
  },
  "7": {
    "class_type": "WanVideoVAELoader",
    "inputs": {
      "model_name": "{{vae}}",
      "precision": "bf16"
    }
  },
  "8": {
    "class_type": "LoadWanVideoT5TextEncoder",
    "inputs": {
      "model_name": "{{t5}}",
      "precision": "bf16",
      "load_device": "offload_device"
    }
  },
  "9": {
    "class_type": "WanVideoTextEncode",
    "inputs": {
      "positive_prompt": "{{prompt}}",
      "negative_prompt": "{{negative}}",
      "t5": ["8", 0],
      "force_offload": true
    }
  },
  "10": {
    "class_type": "CLIPVisionLoader",
    "inputs": { "clip_name": "{{clip_vision}}" }
  },
  "11": {
    "class_type": "WanVideoClipVisionEncode",
    "inputs": {
      "clip_vision": ["10", 0],
      "image_1": ["1", 0],
      "strength_1": 1.0,
      "strength_2": 1.0,
      "crop": "center",
      "combine_embeds": "average",
      "force_offload": true
    }
  },
  "12": {
    "class_type": "WanVideoAnimateEmbeds",
    "inputs": {
      "vae": ["7", 0],
      "width": "{{width}}",
      "height": "{{height}}",
      "num_frames": "{{length}}",
      "force_offload": true,
      "frame_window_size": 77,
      "colormatch": "disabled",
      "pose_strength": "{{pose_strength}}",
      "face_strength": "{{face_strength}}",
      "clip_embeds": ["11", 0],
      "ref_images": ["1", 0],
      "pose_images": ["5", 0],
      "face_images": ["4", 1]
    }
  },
  "13": {
    "class_type": "WanVideoSampler",
    "inputs": {
      "model": ["6", 0],
      "image_embeds": ["12", 0],
      "text_embeds": ["9", 0],
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "shift": "{{shift}}",
      "seed": "{{seed}}",
      "force_offload": true,
      "scheduler": "{{scheduler}}",
      "denoise_strength": 1.0
    }
  },
  "14": {
    "class_type": "WanVideoDecode",
    "inputs": {
      "vae": ["7", 0],
      "samples": ["13", 0],
      "enable_vae_tiling": false
    }
  },
  "15_cv": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["14", 0],
      "fps": "{{fps}}"
    }
  },
  "16_sv": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["15_cv", 0],
      "filename_prefix": "{{prefix}}",
      "format": "mp4"
    }
  }
}
