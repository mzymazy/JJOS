{
  "inputs": [
    {
      "key": "prompt",
      "type": "textarea",
      "label": "正向提示词",
      "required": true,
      "default": "",
      "placeholder": "masterpiece, best quality, ...",
      "group": "basic",
      "order": 1
    },
    {
      "key": "negative",
      "type": "textarea",
      "label": "负向提示词",
      "default": "",
      "placeholder": "lowres, bad anatomy, watermark, ...",
      "group": "basic",
      "order": 2
    },
    {
      "key": "ckpt",
      "type": "select",
      "label": "底模",
      "options": ["RealVisXL_V4.0.safetensors"],
      "default": "RealVisXL_V4.0.safetensors",
      "source": "comfy:ckpt",
      "group": "basic",
      "order": 3
    },
    {
      "key": "width",
      "type": "number",
      "label": "宽",
      "min": 256,
      "max": 2048,
      "step": 64,
      "default": 1024,
      "group": "basic",
      "order": 4
    },
    {
      "key": "height",
      "type": "number",
      "label": "高",
      "min": 256,
      "max": 2048,
      "step": 64,
      "default": 1024,
      "group": "basic",
      "order": 5
    },
    {
      "key": "batch",
      "type": "number",
      "label": "张数",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 1,
      "group": "basic",
      "order": 6
    },
    {
      "key": "steps",
      "type": "number",
      "label": "步数",
      "min": 1,
      "max": 80,
      "step": 1,
      "default": 28,
      "tier_scale": true,
      "help": "随画质档位缩放：draft 减半、final×1.3",
      "group": "advanced",
      "order": 7
    },
    {
      "key": "cfg",
      "type": "slider",
      "label": "CFG",
      "min": 1,
      "max": 15,
      "step": 0.5,
      "default": 5.5,
      "group": "advanced",
      "order": 8
    },
    {
      "key": "sampler",
      "type": "select",
      "label": "采样器",
      "options": ["dpmpp_2m", "dpmpp_2m_sde", "euler", "euler_ancestral", "dpm_2", "ddim", "uni_pc"],
      "default": "dpmpp_2m",
      "source": "comfy:samplers",
      "group": "advanced",
      "order": 9
    },
    {
      "key": "scheduler",
      "type": "select",
      "label": "调度器",
      "options": ["karras", "normal", "exponential", "sgm_uniform", "simple", "ddim_uniform", "beta"],
      "default": "karras",
      "source": "comfy:schedulers",
      "group": "advanced",
      "order": 10
    },
    {
      "key": "seed",
      "type": "seed",
      "label": "种子",
      "default": -1,
      "help": "-1 表示每次随机",
      "group": "advanced",
      "order": 11
    },
    {
      "key": "prefix",
      "type": "text",
      "label": "文件名前缀",
      "default": "localjimeng/txt2img",
      "advanced": true,
      "group": "advanced",
      "order": 12
    }
  ],
  "outputs": [
    {"key": "image", "type": "image", "label": "生成图"}
  ],
  "tiers": ["draft", "balanced", "final"],
  "groups": [
    {"key": "basic", "label": "基础"},
    {"key": "advanced", "label": "高级"}
  ]
}
